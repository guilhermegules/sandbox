      "link": null,
      "locked": false,
      "text": "def bigger(arr):\n    bigger = -inf\n    for n in arr:\n        bigger = max(bigger, n)\n    return bigger",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def bigger(arr):\n    bigger = -inf\n    for n in arr:\n        bigger = max(bigger, n)\n    return bigger",
      "autoResize": true,
      "lineHeight": 1.25
    },
