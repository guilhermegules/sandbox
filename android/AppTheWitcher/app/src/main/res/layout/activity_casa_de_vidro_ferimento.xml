<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/casadevidrogeraltferido"
    android:orientation="vertical"
    tools:context=".CasaDeVidroFerimentoActivity">

    <TextView
        android:id="@+id/txtCasaDeVidroFerimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_weight="0.1"
        android:background="#CB000000"
        android:fontFamily="@font/press_start_2p"
        android:text="Geralt estando ferido, acaba por desmaiar e é ajudado por uma caravana de mercadores que por uma sorte do destino levava uma antiga amiga de Geralt para cidade, essa era a Shani uma renomada médica, que mesmo com poucos recursos conseguiu ajudar Geralt nos tratamentos básicos."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="30dp"
        android:layout_weight="10"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnFerimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#CB000000"
            android:fontFamily="@font/press_start_2p"
            android:text="Assim Geralt foi levado para a cidade, assim podendo receber os tratamentos necessários."
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>