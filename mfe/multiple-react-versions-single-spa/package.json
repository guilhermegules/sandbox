{
  "name": "multiple-react-versions-single-spa",
  "private": true,
  "workspaces": [
    "root-config",
    "app-react-17",
    "app-react-18",
    "app-react-19"
  ],
  "scripts": {
    "start": "concurrently --names \"root,17,18,19\" --prefix-colors \"blue,green,yellow,magenta\" \"npm start --workspace=root-config\" \"npm start --workspace=app-react-17\" \"npm start --workspace=app-react-18\" \"npm start --workspace=app-react-19\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
