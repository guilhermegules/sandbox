<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Multiple React Versions - single-spa</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0; background: #f5f5f5; }
    .nav { background: #1a1a2e; color: white; padding: 1rem 2rem; display: flex; gap: 1rem; align-items: center; }
    .nav a { color: white; text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; transition: background 0.2s; }
    .nav a:hover { background: rgba(255,255,255,0.1); }
    .nav a.active { background: rgba(255,255,255,0.2); font-weight: bold; }
    .content { padding: 2rem; max-width: 1200px; margin: 0 auto; }
    .app-container { border: 2px dashed #ccc; border-radius: 8px; padding: 1.5rem; margin-top: 1rem; min-height: 200px; background: white; }
    .app-label { font-size: 0.8rem; color: #666; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
    .loading { color: #999; text-align: center; padding: 2rem; }
  </style>
</head>
<body>
  <nav class="nav">
    <strong>MFE Playground</strong>
    <a href="/react-17" onclick="event.preventDefault(); navigate('/react-17')">React 17</a>
    <a href="/react-18" onclick="event.preventDefault(); navigate('/react-18')">React 18</a>
    <a href="/react-19" onclick="event.preventDefault(); navigate('/react-19')">React 19</a>
  </nav>

  <script>
    function navigate(path) {
      window.history.pushState({}, '', path);
      window.dispatchEvent(new PopStateEvent('popstate'));
    }
  </script>

  <% if (isLocal) { %>
  <script type="systemjs-importmap">
    {
      "imports": {
        "@mfe/app-react-17": "http://localhost:9001/app-react-17.js",
        "@mfe/app-react-18": "http://localhost:9002/app-react-18.js",
        "@mfe/app-react-19": "http://localhost:9003/app-react-19.js"
      }
    }
  </script>
  <% } %>

  <script type="systemjs-importmap">
    {
      "imports": {
        "single-spa": "https://cdn.jsdelivr.net/npm/single-spa@5.9.3/lib/system/single-spa.min.js",
        "react-17": "https://cdn.jsdelivr.net/npm/react@17.0.2/umd/react.development.js",
        "react-dom-17": "https://cdn.jsdelivr.net/npm/react-dom@17.0.2/umd/react-dom.development.js",
        "react-18": "https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.development.js",
        "react-dom-18": "https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.development.js",
        "react-19": "https://cdn.jsdelivr.net/npm/react@19.2.7/umd/react.development.js",
        "react-dom-19": "https://cdn.jsdelivr.net/npm/react-dom@19.2.7/umd/react-dom.development.js"
      }
    }
  </script>

  <script type="systemjs-importmap">
    {
      "imports": {
        "@mfe/root-config": "/root-config.js"
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/import-map-overrides@3.0.0/dist/import-map-overrides.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/systemjs@6.13.0/dist/system.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/systemjs@6.13.0/dist/extras/amd.min.js"></script>

  <script>
    System.import('@mfe/root-config');
  </script>
</body>
</html>
